# Copy to .env.local and fill in. Never commit real values.

# Admin dashboard login (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# Supabase secret key (server-only): Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=

# Optional overrides (defaults point at supabase-charcoal-planet / www.axonarbor.in)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SITE_URL=
